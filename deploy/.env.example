# Copy to /opt/michy-flow/.env on the server and fill in. Never commit the real file.

DOMAIN=flow.example.com
# owner/repo in lowercase, e.g. ramprasath/michy-flow
GH_REPO=owner/michy-flow
# Set by scripts/deploy.sh on every deploy (the git commit SHA).
IMAGE_TAG=latest

POSTGRES_DB=michy_flow
POSTGRES_USER=michy
# Letters and digits only (it goes into a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Login stays valid this long without activity; the app refreshes it while in use.
JWT_EXPIRE_HOURS=1
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# true only for the first sign-up (creates the organisation and Super Admin), then false.
ALLOW_SIGNUP=false
# Brevo (brevo.com) sends the sign-up code and welcome mails. API key needs "Transactional email: All".
BREVO_API_KEY=
MAIL_FROM_EMAIL=noreply@michyconnect.in
MAIL_FROM_NAME=Michy Rubbers
BACKUP_KEEP_DAYS=7
