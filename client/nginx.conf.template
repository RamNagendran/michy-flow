# ${DOMAIN} serves the app, api.${DOMAIN} the API, www.${DOMAIN} redirects to the app.
# One certificate covers all three names (stored under live/${DOMAIN}).

limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:10m;
server_tokens off;

server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN} api.${DOMAIN};

    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    return 301 https://${DOMAIN}$request_uri;
}

# App: static React build only.
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    root /usr/share/nginx/html;

    # Hashed build files never change: cache for a year.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: every other path is the app. index.html is never cached so new deploys show at once.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}

# API: everything is passed to FastAPI as is.
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Bills are up to 10 MB.
    client_max_body_size 12m;

    gzip on;
    gzip_types application/json;
    gzip_min_length 1024;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;

    # Live updates. Long timeout so idle sockets stay open.
    location = /ws {
        proxy_pass http://api:8000/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location = /auth/login {
        limit_req zone=login burst=5 nodelay;
        proxy_pass http://api:8000/auth/login;
    }

    location / {
        proxy_pass http://api:8000;
        # OCR on a scanned bill can take a while.
        proxy_read_timeout 120s;
    }
}
