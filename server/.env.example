# --- Required ---
# postgres:// and postgresql:// are rewritten to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/michy_flow_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# --- Optional (defaults shown) ---
ENV_NAME=development
JWT_EXPIRE_HOURS=12
JWT_REFRESH_EXPIRE_DAYS=14
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_ENABLED=true
# Set to false in production once the organisation and its Super Admin exist.
ALLOW_SIGNUP=true
# Create missing tables and apply pending migrations on startup.
AUTO_MIGRATE=true
# Fernet key for encrypting stored third-party tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Only when running more than one API instance: a LISTEN-capable Postgres URL for live updates
# (Supabase: direct connection or session pooler on port 5432).
REALTIME_LISTEN_URL=
